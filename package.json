{
  "name": "deepseek-harness-shell",
  "version": "1.1.0",
  "description": "DeepSeek Harness 跨平台桌面壳：Windows / macOS / Linux，原生级体验",
  "author": "DeepSeek Harness Shell contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "start": "tauri dev",
    "dev:renderer": "vite --config vite.config.ts",
    "build": "npm run build:renderer",
    "build:renderer": "vite build --config vite.config.ts",
    "build:tauri": "tauri build",
    "dev:tauri": "tauri dev",
    "pack:mac": "tauri build --bundles app,dmg",
    "pack:win": "tauri build --bundles nsis",
    "pack:linux": "tauri build --bundles deb,appimage",
    "typecheck": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
